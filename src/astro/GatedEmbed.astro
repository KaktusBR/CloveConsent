---
import { assertValidatedConfig, buildView, hostAllowed, renderPlaceholder } from 'cloveconsent'
import type { ClientEntry, ConsentConfig, Locale } from 'cloveconsent'
import './consent.css'
interface Props { config: ConsentConfig; locale: Locale; serviceId: string; src: string; title?: string }
const { config, locale, serviceId, src, title } = Astro.props
assertValidatedConfig(config, 'GatedEmbed')
const entry = config.services.find((s) => s.id === serviceId)
if (!entry || entry.kind !== 'client') throw new Error(`[consent] GatedEmbed: "${serviceId}" is not a selected client service`)
if (!hostAllowed(entry as ClientEntry, src)) throw new Error(`[consent] GatedEmbed: src host not allowed for ${serviceId}: ${src}`)
const view = buildView(config, locale)
const label = title ?? entry.messages.title[view.locale]
---
<div data-consent-embed data-consent-service={serviceId} data-consent-src={src} data-consent-title={label}>
  <Fragment set:html={renderPlaceholder(view, serviceId, label)} />
</div>
