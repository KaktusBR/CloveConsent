---
import { assertValidatedConfig } from 'cloveconsent'
import type { ConsentConfig, Locale } from 'cloveconsent'
import './consent.css'
interface Props { config: ConsentConfig; locale: Locale; class?: string }
const { config, locale, class: cls } = Astro.props
assertValidatedConfig(config, 'ConsentReopen')
const l = config.locales.includes(locale) ? locale : config.defaultLocale
---
<button type="button" data-consent-open class={cls ? `${cls} consent-reopen` : 'consent-reopen'}>{config.messages[l]!.reopen}</button>
