---
import Base from '../layouts/Base.astro'
import { m } from '../paraglide/messages.js'
---

<Base title={m.home_title()}>
  <main class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">{m.home_heading()}</h1>
    <p class="text-muted-foreground mt-4">{m.home_intro()}</p>
  </main>
</Base>
