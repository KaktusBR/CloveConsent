---
import Base from '../../layouts/Base.astro'
import { localeStaticPaths } from '../../i18n/locale'
import { m } from '../../paraglide/messages.js'

// Static: built once per language (dist/client/index.html, dist/client/sk/index.html).
export const prerender = true
export const getStaticPaths = localeStaticPaths
---

<Base title={m.home_title()}>
  <main class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">{m.home_heading()}</h1>
    <p class="text-muted-foreground mt-4">{m.home_intro()}</p>
  </main>
</Base>
