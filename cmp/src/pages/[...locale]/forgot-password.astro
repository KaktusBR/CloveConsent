---
import ForgotPasswordForm from '../../components/auth/ForgotPasswordForm'
import AuthPage from '../../layouts/AuthPage.astro'
import { localeFromParam, localizedPath } from '../../i18n/locale'
import { m } from '../../paraglide/messages.js'

export const prerender = false

const locale = localeFromParam(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')
---

<AuthPage title={m.forgot_password_title()} heading={m.forgot_password_heading()}>
  <p>{m.forgot_password_intro()}</p>
  <ForgotPasswordForm client:load />
  <p class="text-sm">
    <a class="underline underline-offset-4" href={localizedPath('/sign-in', locale)}>{m.sign_up_sign_in_link()}</a>
  </p>
</AuthPage>
