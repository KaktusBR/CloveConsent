---
import ResetPasswordForm from '../../components/auth/ResetPasswordForm'
import AuthPage from '../../layouts/AuthPage.astro'
import { localeFromParam, localizedPath } from '../../i18n/locale'
import { m } from '../../paraglide/messages.js'

// Where the emailed reset link lands: `?token=` (checked by Better Auth when the form is sent).
export const prerender = false

const locale = localeFromParam(Astro.params.locale)
if (!locale) return Astro.rewrite('/404')

const token = Astro.url.searchParams.get('token') ?? ''
// The URL holds a one-time token: never cached.
Astro.response.headers.set('Cache-Control', 'no-store')
---

<AuthPage title={m.reset_password_title()} heading={m.reset_password_heading()} indexable={false}>
  {
    token === '' || token.length > 512 ? (
      <>
        <p role="alert" class="text-destructive font-medium">{m.auth_error_link_invalid()}</p>
        <a class="underline underline-offset-4" href={localizedPath('/forgot-password', locale)}>{m.sign_in_forgot_link()}</a>
      </>
    ) : (
      <ResetPasswordForm client:load token={token} signInHref={localizedPath('/sign-in', locale)} />
    )
  }
</AuthPage>
