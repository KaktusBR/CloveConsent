---
import Base from '../layouts/Base.astro'
import { localizedPath } from '../i18n/locale'
import { m } from '../paraglide/messages.js'
---

<Base title={m.not_found_title()}>
  <main class="mx-auto max-w-2xl px-4 py-12">
    <h1 class="text-3xl font-semibold tracking-tight">{m.not_found_heading()}</h1>
    <p class="text-muted-foreground mt-4">{m.not_found_body()}</p>
    <p class="mt-6"><a class="underline underline-offset-4" href={localizedPath('/', Astro.locals.locale)}>{m.not_found_home_link()}</a></p>
  </main>
</Base>
