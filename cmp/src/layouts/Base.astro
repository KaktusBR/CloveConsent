---
import '../styles/global.css'
import LocaleSwitcher from '../components/LocaleSwitcher.astro'
import { baseLocale, localizedPath, locales, splitLocalePrefix, type Locale } from '../i18n/locale'
import { buildOrigin } from '../server/origin'

interface Props {
  /** Document title, already translated by the page. */
  title: string
  /** False for pages that are not a URL to index (the 404): no canonical link, no hreflang alternates. */
  indexable?: boolean
}

const { title, indexable = true } = Astro.props
const locale = Astro.locals.locale
// The page path without its language prefix.
const { path } = splitLocalePrefix(Astro.url.pathname)
// A prerendered page is built without the server's environment: only PUBLIC_ORIGIN is needed then.
const origin = Astro.isPrerendered ? buildOrigin() : (await import('../server/env')).env.PUBLIC_ORIGIN
const href = (l: Locale) => new URL(localizedPath(path, l), origin).href
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {
      indexable && (
        <>
          <link rel="canonical" href={href(locale)} />
          {locales.map((l) => (
            <link rel="alternate" hreflang={l} href={href(l)} />
          ))}
          <link rel="alternate" hreflang="x-default" href={href(baseLocale)} />
        </>
      )
    }
    <!-- Theme before first paint: an explicit choice in localStorage ("light" | "dark"), else the system preference. -->
    <script is:inline>
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch {
          // storage blocked: follow the system preference
        }
        const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>
  </head>
  <body class="min-h-dvh antialiased">
    <header class="flex justify-end p-4">
      <LocaleSwitcher path={path + Astro.url.search} current={locale} />
    </header>
    <slot />
  </body>
</html>
