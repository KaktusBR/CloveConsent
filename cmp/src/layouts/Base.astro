---
import '../styles/global.css'
import LocaleSwitcher from '../components/LocaleSwitcher'
import { baseLocale, localizedPath, locales, splitLocalePrefix } from '../i18n/locale'
import { env } from '../server/env'

interface Props {
  /** Document title, already translated by the page. */
  title: string
}

const { title } = Astro.props
const locale = Astro.locals.locale
// The page path without its language prefix (whether Astro.url is the request or the rewritten URL).
const { path } = splitLocalePrefix(Astro.url.pathname)
const href = (l: typeof locale) => new URL(localizedPath(path, l), env.PUBLIC_ORIGIN).href
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    {locales.map((l) => <link rel="alternate" hreflang={l} href={href(l)} />)}
    <link rel="alternate" hreflang="x-default" href={href(baseLocale)} />
    <!-- Theme before first paint: an explicit choice in localStorage ("light" | "dark"), else the system preference. -->
    <script is:inline>
      ;(() => {
        let stored = null
        try {
          stored = localStorage.getItem('theme')
        } catch {
          // storage blocked: follow the system preference
        }
        const dark = stored === 'dark' || (stored !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
      })()
    </script>
  </head>
  <body class="min-h-dvh antialiased">
    <header class="flex justify-end p-4">
      <LocaleSwitcher client:load path={path + Astro.url.search} current={locale} />
    </header>
    <slot />
  </body>
</html>
