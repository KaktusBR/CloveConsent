# Copy to .env.db for `npm run db:init` and `npm run db:migrate`. Never give these to the app or worker:
# the owner role can turn row-level security off, the admin can create roles.
# Values below match compose.yaml and are for local development only.

# Owner role cmp_owner: runs migrations, owns the tables
DATABASE_URL_MIGRATE=postgres://cmp_owner:cmp_owner@localhost:5432/cmp
# A role that may create roles and databases (here the compose superuser); used by db:init and test:db only
DATABASE_URL_ADMIN=postgres://postgres:postgres@localhost:5432/postgres
# Backup role cmp_backup (optional here; production's backup service connects as it): read-only, bypasses
# row-level security so pg_dump sees every row. db:init creates it when this is set.
DATABASE_URL_BACKUP=postgres://cmp_backup:cmp_backup@localhost:5432/cmp
