# Copy to .env for `npm run dev` / `npm start` / `npm run worker` (loaded with node --env-file-if-exists).
# Values below match compose.yaml and are for local development only.

# App connection (in production: the non-owner app role, so row-level security applies)
DATABASE_URL=postgres://cmp:cmp@localhost:5432/cmp
# Owner role, used only to run migrations
DATABASE_URL_MIGRATE=postgres://cmp:cmp@localhost:5432/cmp
# System role, used only by audited system work (super-admin, worker)
DATABASE_URL_SYSTEM=postgres://cmp:cmp@localhost:5432/cmp

# At least 32 bytes; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The public origin of the app: https, or http only for localhost. No path.
PUBLIC_ORIGIN=http://localhost:4321

SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@localhost.test

# Comma-separated; may be empty
SUPER_ADMIN_EMAILS=

# development | test | production
NODE_ENV=development
