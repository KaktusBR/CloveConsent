# Copy to .env for `npm run dev` / `npm start` / `npm run worker` (loaded with node --env-file-if-exists).
# Values below match compose.yaml and are for local development only.

# The roles are created by `npm run db:init` (see scripts/db-init.ts); the role names are fixed.
# App connection: cmp_app, the non-owner runtime role, so row-level security applies
DATABASE_URL=postgres://cmp_app:cmp_app@localhost:5432/cmp
# System role cmp_system, used only by audited system work (super-admin, worker)
DATABASE_URL_SYSTEM=postgres://cmp_system:cmp_system@localhost:5432/cmp
# The owner and admin credentials are NOT here: they live in .env.db (see .env.db.example), which only
# `npm run db:init` / `npm run db:migrate` read. The app and worker never receive them.

# At least 32 bytes; generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=

# The public origin of the app: https, or http only for localhost. No path.
PUBLIC_ORIGIN=http://localhost:4321

SMTP_URL=smtp://localhost:1025
MAIL_FROM=noreply@localhost.test

# Comma-separated; may be empty
SUPER_ADMIN_EMAILS=

# development | test | production
NODE_ENV=development
