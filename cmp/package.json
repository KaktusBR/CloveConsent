{
  "name": "cloveconsent-cmp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "i18n": "paraglide-js compile --project ./project.inlang --silent",
    "dev": "npm run i18n && node --env-file-if-exists=.env node_modules/astro/bin/astro.mjs dev",
    "build": "npm run i18n && astro build && npm run build:worker",
    "build:worker": "esbuild src/worker.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/worker.js",
    "start": "node --env-file-if-exists=.env dist/server/entry.mjs",
    "worker": "node --env-file-if-exists=.env dist/worker.js",
    "typecheck": "npm run i18n && astro check && tsc --noEmit",
    "lint": "eslint .",
    "check:words": "node scripts/check-words.ts",
    "test": "npm run i18n && vitest run",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:init": "node --env-file-if-exists=.env --env-file-if-exists=.env.db scripts/db-init.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.db scripts/migrate.ts"
  },
  "dependencies": {
    "@astrojs/node": "11.1.12",
    "@astrojs/react": "7.1.8",
    "@hookform/resolvers": "7.0.6",
    "@tailwindcss/vite": "4.3.5",
    "astro": "7.4.11",
    "class-variance-authority": "0.7.1",
    "cloveconsent": "file:..",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.72.0",
    "nodemailer": "10.5.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/compiler": "4.0.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@inlang/paraglide-js": "3.2.2",
    "@inlang/plugin-message-format": "4.6.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "astro-eslint-parser": "3.2.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
