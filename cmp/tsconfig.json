{
  "extends": "astro/tsconfigs/strictest",
  "include": [".astro/types.d.ts", "src/**/*", "scripts/**/*", "test/**/*", "e2e/**/*", "*.config.ts", "*.config.mjs", "eslint.config.js"],
  "exclude": ["dist", "node_modules", "src/paraglide"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["node"],
    "paths": { "@/*": ["./src/*"] }
  }
}
